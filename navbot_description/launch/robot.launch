<launch>
  <include file="$(find rplidar_ros)/launch/rplidar.launch" />

  <node name="object_avoidance" pkg="navbot_description" type="object_avoidance.py" output="screen" />

  <!-- Optional: Uncomment if you want to use teleop -->
