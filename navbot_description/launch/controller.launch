<launch>

<rosparam file="$(find navbot_description)/launch/controller.yaml" command="load"/>
<node name="controller_spawner" pkg="controller_manager" type="spawner" respawn="false" output="screen" ns="navbot" args="frontwheel_right_joint_position_controller frontwheel_left_joint_position_controller rarewheel_right_joint_position_controller rarewheel_left_joint_position_controller joint_state_controller "/>
<node name="robot_state_publisher" pkg="robot_state_publisher" type="robot_state_publisher" respawn="false" output="screen">
  <remap from="/joint_states" to="/navbot/joint_states"/>
</node>

</launch>